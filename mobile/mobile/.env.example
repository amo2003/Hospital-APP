# Local Expo LAN development: use auto to follow the current Metro/browser host on port 4000.
# Restart Expo after switching Wi-Fi/hotspot, then scan the new QR code.
# Release APKs and Expo tunnels need an explicit reachable API URL, INCLUDING /api.
# Public values are bundled into the app.
EXPO_PUBLIC_API_URL=https://YOUR_BACKEND_HOST/api
# Google Console WEB OAuth client ID. Required on web AND Android/iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Only needed for iOS. app.config.js derives its reversed URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android client must be created for com.careplus.patient + build signing SHA-1.
# Its ID is recorded here for reference; the native SDK uses the WEB client ID.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
