NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/********?retryWrites=true&w=majority
MONGODB_DB=careplus

DNS_SERVERS=
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Comma-separated accepted token audiences. Include the same WEB client ID used by the app.
GOOGLE_CLIENT_IDS=
# Used for automatic registration welcome emails and password-reset emails.
# Use your email provider's SMTP credentials; never put these in the mobile .env.
SMTP_HOST=
# EMAIL_HOST, EMAIL_USER and EMAIL_PASSWORD are also supported.
# If both are set, non-empty SMTP_* values take precedence.
# 587 uses STARTTLS; 465 uses TLS from connection start.
SMTP_PORT=587
# Optional; defaults to true for port 465, false otherwise.
# SMTP_SECURE=false
SMTP_USER=
# Use an SMTP/app password supplied by your provider.
SMTP_PASSWORD=
# Use a verified sender address belonging to your email provider/account.
SMTP_FROM=CarePlus <no-reply@example.com>
# Optional public HTTPS app/login URL for the welcome email button.
PATIENT_APP_URL=
