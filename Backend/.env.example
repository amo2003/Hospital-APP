NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/careplus?retryWrites=true&w=majority
MONGODB_DB=careplus

# Optional: use if Node fails to resolve Atlas SRV records on your network.
DNS_SERVERS=1.1.1.1,8.8.8.8

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

CORS_ORIGINS=http://localhost:8081,http://localhost:19006

GOOGLE_CLIENT_IDS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CarePlus <no-reply@example.com>
