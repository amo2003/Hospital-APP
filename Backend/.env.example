NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/careplus?retryWrites=true&w=majority
MONGODB_DB=careplus
# Optional: use if Node fails to resolve Atlas SRV records on your network.
DNS_SERVERS=
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
GOOGLE_CLIENT_IDS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CarePlus <no-reply@example.com>
